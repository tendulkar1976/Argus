# Argus Backend Environment Configuration
APP_NAME=Argus
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama Inference (Phase 3 & 3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_STATUS_TIMEOUT_SECONDS=4.0

# Model Generation Hyperparameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Heuristic & Optimization Limits
CHARS_PER_TOKEN_HEURISTIC=4.0
MAX_VALIDATION_RETRY_ATTEMPTS=1

# Google Gemini Provider (Available External Service 1)
# Keep GEMINI_API_KEY secure in local uncommitted .env only. Never commit real keys.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60.0

# DeepSeek Provider (Available External Service 2)
# Keep DEEPSEEK_API_KEY secure in local uncommitted .env only. Never commit real keys.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60.0

# Local Ollama Inference Provider
OLLAMA_LLM_TIMEOUT_SECONDS=60.0

# Intelligent Model Routing (Phase 6)
ROUTING_DEFAULT_STRATEGY=balanced
ROUTING_WEIGHT_QUALITY=0.40
ROUTING_WEIGHT_COST=0.35
ROUTING_WEIGHT_LATENCY=0.25
ROUTING_DEFAULT_MODEL=gemini-2.0-flash
ROUTING_FALLBACK_CHAIN=["gemini-2.0-flash","deepseek-chat","qwen2.5:1.5b"]

# Cost & Telemetry Engine (Phase 8)
TELEMETRY_ENABLED=true
TELEMETRY_STORAGE_BACKEND=sqlite
TELEMETRY_DB_PATH=argus_telemetry.db
TELEMETRY_MAX_MEMORY_RECORDS=1000

# TinyFish Browser Automation (Available External Service 3)
# Dedicated browser automation capability — kept strictly separate from LLM routing.
# Disabled by default to prevent unintended external browser automation calls.
TINYFISH_ENABLED=false
TINYFISH_API_KEY=your-tinyfish-api-key-here
TINYFISH_BASE_URL=https://api.tinyfish.io/v1
TINYFISH_TIMEOUT_SECONDS=120.0
TINYFISH_MAX_CONCURRENT_TASKS=2



