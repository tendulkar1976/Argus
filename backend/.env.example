# Argus Backend Environment Configuration
APP_NAME=Argus
ENVIRONMENT=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local Ollama Inference (Phase 3 & 3.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_STATUS_TIMEOUT_SECONDS=4.0

# Model Generation Hyperparameters
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# Heuristic & Optimization Limits
CHARS_PER_TOKEN_HEURISTIC=4.0
MAX_VALIDATION_RETRY_ATTEMPTS=1

# Frontier OpenAI / OpenRouter Provider (Phase 4.1 & 4.2)
# SAFETY NOTICE: Upstream dispatch is disabled by default to prevent unintended API charges.
# Set ENABLE_UPSTREAM_DISPATCH=true explicitly only when you intend to call the external provider.
ENABLE_UPSTREAM_DISPATCH=false

# Keep OPENAI_API_KEY secure in local uncommitted .env only. Never commit real keys.
OPENAI_API_KEY=your-openai-or-openrouter-api-key-here

# Optional base URL for OpenAI-compatible providers like OpenRouter.
# Leave unset or commented out for official OpenAI (defaults to https://api.openai.com/v1).
# For OpenRouter, set: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model identifier to dispatch requests to.
# For official OpenAI, e.g.: gpt-6.1-sol or gpt-4o-mini
# For OpenRouter, e.g.: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, or meta-llama/llama-3.3-70b-instruct
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TIMEOUT_SECONDS=60.0
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=medium



